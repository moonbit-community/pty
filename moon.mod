name = "moonbit-community/pty"

version = "0.4.3"

import {
  "moonbitlang/async@0.22.4",
}

readme = "README.md"

repository = "https://github.com/moonbit-community/pty"

license = "Apache-2.0"

keywords = [ "pty", "pseudo-terminal", "async", "native", "wasm" ]

description = "Cross-platform PTY (pseudo-terminal) spawning for MoonBit, integrated with moonbitlang/async: directly on native targets, through a sidecar process on wasm."

preferred_target = "native"
